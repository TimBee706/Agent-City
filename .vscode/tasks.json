{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "compile",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc"
    },
    {
      "type": "npm",
      "script": "watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "esbuild",
        "pattern": { "regexp": "^✘ \[ERROR\] (.*)$", "message": 1 },
        "background": {
          "activeBegins": true,
          "beginsPattern": "\[watch\] build started",
          "endsPattern": "\[watch\] build finished"
        }
      }
    },
    {
      "type": "npm",
      "script": "pretest:integration",
      "problemMatcher": "$tsc"
    }
  ]
}
